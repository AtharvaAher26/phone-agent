    xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.atharva.phoneagent.AssistantSessionService"
    android:recognitionService="com.atharva.phoneagent.StubRecognitionService"
    android:supportsAssist="true" />
